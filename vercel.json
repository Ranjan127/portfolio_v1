{
  "version": 2,
  "builds": [
    {
      "src": "api/contact.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/portfolio/home.html"
    },
    {
      "src": "/(.*)",
      "dest": "/portfolio/$1"
    },
    {
      "src": "/api/contact",
      "dest": "/api/contact.js"
    }
  ]
}
